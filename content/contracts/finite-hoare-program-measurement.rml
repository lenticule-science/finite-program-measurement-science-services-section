#lang rmn/v2
(map
  ("type" "FiniteHoareProgramMeasurementLaw")
  ("version" 1)
  ("provider" "urn:ame:hoare-program-measurement")
  ("precondition" "The customer supplies an explicit finite total relation, source-identified observations, customer authority, accepted provider terms, and a capability attenuated to the exact request and provider-local witness journal evidence.")
  ("operation" "The provider measures preservation and counterexamples over the supplied relation, derives its weakest compatible input set, compares customer-authored observations without claiming their truth, and records only provider-local witnessed evidence.")
  ("postcondition" "The provider returns one qualified measurement or typed refusal preserving the exact normalized request identity, formal-carrier identity, evidence limits, typed resources, and both settlement membranes.")
  ("refusal" "Refuse a malformed or non-total relation, missing observation authority, changed normalized terms, an overbroad capability, fake payment equivalence, cross-settlement mutation, or an unqualified empirical or formal claim.")
  ("protocol" "ActivityStreams-2.0")
  ("evidence" "WITNESS-JOURNAL-RDF"))
